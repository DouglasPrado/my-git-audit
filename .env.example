# Token do GitHub usado pelo coletor. Em produção vem da Backend API do Clerk
# (ADR-0012); em desenvolvimento, um PAT com escopo `repo` basta.
# Nunca é enviado ao cliente, a log, a telemetria ou a um modelo.
GITHUB_TOKEN=

# Análise semântica (Épico 5). Sem chave o produto roda determinístico e marca
# as categorias afetadas como "parcialmente interpretado" — é um modo, não erro.
# O @gba/ai-harness fala OpenRouter por padrão.
AI_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4-20250514
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_FAKE=1   # intérprete determinístico, para exercitar o caminho sem gastar
